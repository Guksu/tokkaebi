{
  "name": "@tokkaebi/core",
  "version": "1.0.0",
  "description": "Parser, pricing, and aggregation engine for tokkaebi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guksu/tokkaebi.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Guksu/tokkaebi#readme",
  "keywords": [
    "claude-code",
    "token-usage",
    "cost-tracking",
    "local-first"
  ],
  "engines": {
